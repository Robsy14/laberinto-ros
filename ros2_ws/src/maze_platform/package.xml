<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>maze_platform</name>
  <version>0.1.0</version>
  <description>
    Etapa 1 del proyecto de laberinto: modelo en Gazebo Harmonic de la
    plataforma inclinable de 2 GDL, el laberinto 7x7 y la esfera, para
    ROS 2 Jazzy.
  </description>
  <maintainer email="lrobsana@unal.edu.co">Lina Robsana Jamioy Tisoy</maintainer>
  <maintainer email="trocha@unal.edu.co">Tomas Rocha Castano</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
